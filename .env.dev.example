# Local test environment — copy to `.env.dev` (gitignored):
#   cp .env.dev.example .env.dev
#
# Used by docker-compose.dev.yml and scripts/dev-up.sh.
# Compose overrides DB_URL / REDIS_URL to use in-network service names.

# Published host ports (change if busy)
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_API_PORT=8000
DEV_TRUSTTWIN_API_PORT=8080
DEV_REDPANDA_PORT=19092

# Kafka/Redpanda (used by trusttwin-api producer and detection-engine consumer in compose)
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC=trusttwin.events

# Shared by trusttwin-api container and laptop agent (optional in dev).
TRUSTTWIN_ENROLL_TOKEN=

# Dashboard on http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Empty ADMIN_API_TOKEN disables admin auth (local only).
# If you set a token, put the same value in frontend/.env.development
# as REACT_APP_ADMIN_API_TOKEN.
ADMIN_API_TOKEN=
DNS_INGEST_TOKEN=
DEVICE_TOKEN_SECRET=local-dev-device-secret
WG_AGENT_TOKEN=local-dev-wg-token
WG_AGENT_URL=http://host.docker.internal:9109

# VPN enroll is not functional without EC2 host agents; placeholders only.
VPN_ENDPOINT=
VPN_SERVER_PUBLIC_KEY=

# Faster cold start offline
POLICY_PACK_FETCH_ENABLED=false
POLICY_PACK_REFRESH_ON_STARTUP=false

LOG_LEVEL=INFO
NETWORK_REVIEW_MODE=template
BEHAVIOR_REVIEW_MODE=template
