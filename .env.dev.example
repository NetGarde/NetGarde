# Dev stack (docker-compose.dev.yml)
DEV_API_PORT=8000
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_REDPANDA_PORT=19092
DEV_TRUSTEDGE_AGENT_API_PORT=8080
DEV_OLLAMA_PORT=11434

# Build Agent API from sibling repo (default in docker-compose.dev.yml).
# TRUSTEDGE_AGENT_BUILD_CONTEXT=../TrustEdge-Agent-API

# Kafka/Redpanda (used by trustedge-agent-api producer and detection-engine consumer in compose)
# KAFKA_BROKERS=redpanda:9092
# KAFKA_TOPIC=trustedge.agent.events

# Shared by trustedge-agent-api container and laptop agent (optional in dev).
TRUSTEDGE_AGENT_ENROLL_TOKEN=
