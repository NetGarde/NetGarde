# Root-level env for `docker compose` variable substitution.
# Copy to `.env` on the EC2 host (same directory as docker-compose.yml):
#   cp .env.production.example .env
#
# Docker Compose reads this file automatically for ${VAR} interpolation in docker-compose.yml.

# Host WireGuard agent (systemd service on EC2)
WG_AGENT_URL=http://172.17.0.1:9109
WG_AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# dns-sync: blocked A records → block-page on wg0; AAAA still sinkholed
BLOCK_PAGE_IP=10.0.0.1
BLOCK_IP=10.0.0.1
BLOCK_IPV6_IP=::
BLOCK_PAGE_TLS_DIR=/etc/trustedge/block-page-tls
# Use BLOCK_IP=0.0.0.0 for sinkhole only (browser shows "can't be reached")

# Optional overrides (docker-compose.yml already has defaults)
# VPN_ENDPOINT=44.218.45.174:51820
# VPN_SERVER_PUBLIC_KEY=...

# TrustTwin ingest API (optional on EC2 — compose profile "trusttwin")
# Not started by default. Local dev: docker-compose.dev.yml builds ../TrustTwin on your Mac.
# To run on EC2 later: copy TrustTwin source to the host, set TRUSTTWIN_BUILD_CONTEXT, then:
#   COMPOSE_PROFILES=trusttwin TRUSTTWIN_ENROLL_TOKEN=... docker compose up -d trusttwin-api
# TRUSTTWIN_BUILD_CONTEXT=/home/ubuntu/TrustTwin
# TRUSTTWIN_API_PORT=8080
# TRUSTTWIN_API_HOST_BIND=0.0.0.0
# TRUSTTWIN_ENROLL_TOKEN=
# TRUSTTWIN_PRODUCTION=1
