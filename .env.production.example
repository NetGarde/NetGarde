# Root-level env for `docker compose` variable substitution.
# Copy to `.env` on the EC2 host (same directory as docker-compose.yml):
#   cp .env.production.example .env
#
# Docker Compose reads this file automatically for ${VAR} interpolation in docker-compose.yml.

# WireGuard host agent (systemd service on EC2)
WG_AGENT_URL=http://172.17.0.1:9109
WG_AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# DNS blocking disabled by default (dns-sync / block-page removed from compose)
DNS_BLOCKING_ENABLED=false

# Optional overrides (docker-compose.yml already has defaults)
# VPN_ENDPOINT=44.218.45.174:51820
# VPN_SERVER_PUBLIC_KEY=...

# TrustTwin ingest API (separate repo; image from ECR)
# TRUSTTWIN_API_IMAGE=804012660077.dkr.ecr.us-east-1.amazonaws.com/trustedge-trusttwin-api:latest
# TRUSTTWIN_API_PORT=8080
# TRUSTTWIN_API_HOST_BIND=0.0.0.0
# TRUSTTWIN_ENROLL_TOKEN=  # generated on first deploy → /etc/trustedge/trusttwin-enroll.token
# TRUSTTWIN_PRODUCTION=1

# Kafka/Redpanda event bus (trusttwin-api produces; detection-engine consumes)
# KAFKA_BROKERS=redpanda:9092
# KAFKA_TOPIC=trusttwin.events
