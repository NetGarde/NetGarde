# Example Environment Variables
# Copy to backend/.env.production or use as reference for /etc/trustedge/backend.env

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=trustedge
DB_URL=postgresql+psycopg2://postgres:your_password_here@db:5432/trustedge

# Application Configuration
PYTHONUNBUFFERED=1
ENVIRONMENT=production

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_JSON=1
LOG_SERVICE=backend

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Service ingest token (detection-engine, network flows; historical name DNS_INGEST_TOKEN)
DNS_INGEST_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Redis (TrustEdge Agent live state / twin keys)
REDIS_URL=redis://redis:6379/0

# Device identity tokens (HMAC) for device-authenticated APIs
DEVICE_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DEVICE_TOKEN_TTL_DAYS=365

CLIENT_ATTRIBUTION_PATH=/v1/network-attribution
CLIENT_ATTRIBUTION_POLL_SEC=30
CLIENT_ATTRIBUTION_REPORT_SEC=60

# Network attribution (foreground app → network context)
NETWORK_ATTRIBUTION_ENABLED=true
NETWORK_ATTRIBUTION_MAX_AGE_SEC=120
NETWORK_ATTRIBUTION_RETENTION_DAYS=30

# L4 flow twin (conntrack samples from EC2 host flow_watcher)
NETWORK_FLOWS_ENABLED=true
NETWORK_FLOWS_MAX_AGE_SEC=300
NETWORK_FLOWS_DNS_RESOLUTION_TTL_SEC=600
NETWORK_FLOWS_MAP_LIMIT=80

# Admin identity (dashboard APIs)
ADMIN_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Client behavior profiles (per-device baselines, alerts, optional auto-block)
BEHAVIOR_BASELINE_LOOKBACK_DAYS=7
BEHAVIOR_MIN_PROFILE_HOURS=0
BEHAVIOR_MIN_PROFILE_DAYS=3
BEHAVIOR_MIN_PROFILE_QUERIES=500
BEHAVIOR_BASELINE_RECOMPUTE_HOURS=1
BEHAVIOR_SCORE_WINDOW_MINUTES=15
BEHAVIOR_ALERT_THRESHOLD=70
BEHAVIOR_AUTO_BLOCK_THRESHOLD=85
BEHAVIOR_AUTO_BLOCK_DEFAULT=true
BEHAVIOR_AUTO_BLOCK_TTL_HOURS=24
BEHAVIOR_AUTO_BLOCK_DOMAINS_PER_EVENT=5
BEHAVIOR_MAX_BLOCKS_PER_DAY=10
BEHAVIOR_REVIEW_MODE=template
BEHAVIOR_REVIEW_CACHE_TTL_SEC=300
DEVICE_COUNTRY_ALERT_ENABLED=true
DEVICE_COUNTRY_ALERT_COOLDOWN_HOURS=24

# Dashboard network review: template | openai | ollama
NETWORK_REVIEW_MODE=template
NETWORK_REVIEW_CACHE_TTL_SEC=90
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SEC=180
