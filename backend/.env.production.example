# Production env template (do not rely on backend/.env.production on EC2 — CI used to overwrite it).
#
# On EC2 the live file is:
#   /etc/trustedge/backend.env
#
# First-time setup:
#   sudo mkdir -p /etc/trustedge
#   sudo cp backend/.env.production.example /etc/trustedge/backend.env
#   sudo chown root:docker /etc/trustedge/backend.env && sudo chmod 640 /etc/trustedge/backend.env
#   sudo nano /etc/trustedge/backend.env
#
# Deploy merges DB_URL into /etc/trustedge/backend.env via scripts/ec2-sync-backend-env.sh

DB_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

LOG_TO_FILE=0
LOG_JSON=1
LOG_LEVEL=INFO
LOG_SERVICE=backend
PYTHONUNBUFFERED=1

# Service ingest token (detection-engine, network flows)
DNS_INGEST_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

ADMIN_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

REDIS_URL=redis://redis:6379/0

# AI network review: template (default) | ollama | openai
NETWORK_REVIEW_MODE=template
NETWORK_REVIEW_CACHE_TTL_SEC=90
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=180

BEHAVIOR_REVIEW_MODE=template
BEHAVIOR_REVIEW_CACHE_TTL_SEC=300

# CORS: merged with built-in S3 website + localhost. Add CloudFront if used.
# CORS_ORIGINS=http://localhost:3000,https://daemixzdg8jfd.cloudfront.net
# ALLOWED_ORIGINS=http://trustedge-frontend.s3-website-us-east-1.amazonaws.com
